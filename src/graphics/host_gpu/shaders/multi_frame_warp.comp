// Independent motion-compensated reconstruction; no Lemon implementation is used.
#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D previous_image;
layout(set=0,binding=1) uniform sampler2D current_image;
layout(set=0,binding=2) uniform isampler2D optical_flow;
layout(set=0,binding=3,rgba8) uniform writeonly image2D output_image;
layout(set=0,binding=4) uniform usampler2D scene_change;
layout(set=0,binding=5,std430) buffer Feedback { uint flags; } feedback;
layout(push_constant) uniform Parameters { uvec2 extent; uvec2 flow_extent; float time; uint copy_history; } pc;
layout(set=0,binding=7,rgba32i) uniform readonly iimage2D full_motion;
layout(set=0,binding=8,rgba32f) uniform readonly image2D static_layer;
bool inside(vec2 p){return all(greaterThanEqual(p,vec2(0)))&&all(lessThanEqual(p,vec2(pc.extent)-1.0));}
vec3 old_at(vec2 p){return textureLod(previous_image,(p+0.5)/vec2(pc.extent),0.0).rgb;}
vec3 new_at(vec2 p){return textureLod(current_image,(p+0.5)/vec2(pc.extent),0.0).rgb;}
ivec4 motion_at(ivec2 p){return imageLoad(full_motion,clamp(p,ivec2(0),ivec2(pc.extent)-1));}
// Require the complete nonzero-weight current-image footprint to support this
// motion. Never average opposed layer vectors or iterate an oscillating inverse.
bool supports(vec2 p,ivec2 v){
    if(!inside(p))return false;ivec2 b=ivec2(floor(p));vec2 f=fract(p);
    for(int y=0;y<2;++y)for(int x=0;x<2;++x){
        float weight=(x==0?1.0-f.x:f.x)*(y==0?1.0-f.y:f.y);
        if(weight!=0.0&&any(notEqual(motion_at(b+ivec2(x,y)).xy,v)))return false;
    }
    return true;
}
// Recover a moving background per source texel BEFORE bilinear filtering.
// A valid stationary layer applies to both endpoints at that screen position.
// The error interval is conditional on the fitted beta/K, and derives only from
// nearest RGBA8 uncertainty; it is not a content/scene RGB threshold.
bool background_sample(sampler2D endpoint,vec2 p,ivec2 v,out vec3 color,out float uncertainty){
    color=vec3(0);uncertainty=0.0;if(!inside(p))return false;
    ivec2 base=ivec2(floor(p));vec2 f=fract(p);const float quantum=0.5/255.0;
    for(int y=0;y<2;++y)for(int x=0;x<2;++x){
        float weight=(x==0?1.0-f.x:f.x)*(y==0?1.0-f.y:f.y);if(weight==0.0)continue;
        ivec2 at=base+ivec2(x,y);ivec4 motion=motion_at(at);vec4 layer=imageLoad(static_layer,at);
        vec3 observed=texelFetch(endpoint,at,0).rgb,sample_color;float sample_error;
        if(layer.a>0.0&&all(equal(motion.zw,v))){
            sample_color=(observed-layer.rgb)/layer.a;
            sample_error=quantum*(2.0+layer.a)/layer.a;
            if(!(sample_error<1.0)||any(isnan(sample_color))||any(isinf(sample_color))||
               any(lessThan(sample_color,vec3(-sample_error)))||any(greaterThan(sample_color,vec3(1.0+sample_error))))return false;
            // Project the format-uncertainty interval onto the physical range.
            sample_color=clamp(sample_color,vec3(0),vec3(1));
        }else if(layer.a<0.0&&all(equal(motion.xy,v))){sample_color=observed;sample_error=quantum;}
        else return false; // Opaque or another moving layer is unobservable here.
        color+=weight*sample_color;uncertainty+=weight*sample_error;
    }
    return true;
}
void main() {
    uvec2 pixel=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(pixel,pc.extent)))return;
    ivec2 ip=ivec2(pixel);vec2 x=vec2(pixel);
    if(pc.copy_history!=0u){imageStore(output_image,ip,texelFetch(current_image,ip,0));return;}
    if((texelFetch(scene_change,ivec2(1,0),0).r&15u)!=0u){if(all(equal(pixel,uvec2(0))))atomicOr(feedback.flags,1u);return;}
    vec3 observed=texelFetch(current_image,ip,0).rgb;
    if(all(equal(uvec3(round(texelFetch(previous_image,ip,0).rgb*255.0)),uvec3(round(observed*255.0))))){
        imageStore(output_image,ip,vec4(observed,1));return;
    }
    ivec4 motion=motion_at(ip);ivec2 alternate=motion.zw;
    vec4 layer=imageLoad(static_layer,ip);
    if(layer.a>=0.0){
        // A fully opaque static contribution requires no unobserved background.
        if(layer.a==0.0){imageStore(output_image,ip,vec4(layer.rgb,1));return;}
        vec2 p=x+pc.time*vec2(alternate),q=x-(1.0-pc.time)*vec2(alternate);
        vec3 b0,b1;float error0,error1;
        if(background_sample(previous_image,p,alternate,b0,error0)&&
           background_sample(current_image,q,alternate,b1,error1)){
            if(max(max(abs(b0.r-b1.r),abs(b0.g-b1.g)),abs(b0.b-b1.b))<=error0+error1){
                vec3 predicted=layer.rgb+layer.a*(b0+b1)*0.5;
                if(!any(isnan(predicted))&&!any(isinf(predicted))&&all(greaterThanEqual(predicted,vec3(0)))&&all(lessThanEqual(predicted,vec3(1)))){
                    imageStore(output_image,ip,vec4(predicted,1));return;
                }
            }
        }
        // A fitted stationary contribution must not be moved by a rejected
        // background hypothesis. Keep its actually observed endpoint samples.
        // beta=1,K=0 is an exactly pure-moving fitted model: there is no
        // stationary contribution to freeze. Retain ordinary motion recovery.
        if(layer.a!=1.0||any(notEqual(layer.rgb,vec3(0)))){
            imageStore(output_image,ip,vec4(mix(old_at(x),new_at(x),pc.time),1));return;
        }
    }
    ivec2 candidates[3]=ivec2[](motion.xy,motion.zw,ivec2(0));
    vec3 result=mix(old_at(x),new_at(x),pc.time);float best=1.0e20;
    for(int i=0;i<3;++i){
        ivec2 v=candidates[i];bool duplicate=false;for(int j=0;j<i;++j)duplicate=duplicate||all(equal(v,candidates[j]));if(duplicate)continue;
        vec2 q=x-(1.0-pc.time)*vec2(v),p=x+pc.time*vec2(v);
        if(!inside(p)||!supports(q,v))continue;
        vec3 a=old_at(p),b=new_at(q);float error=dot(a-b,a-b);
        if(error<best){best=error;result=mix(a,b,pc.time);}
    }
    // No consistent moving hypothesis: retain endpoint samples at their observed
    // screen position rather than blending a trusted background with a mapped glyph.
    imageStore(output_image,ip,vec4(result,1));
}
