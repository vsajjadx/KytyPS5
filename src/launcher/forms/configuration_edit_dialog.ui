         <widget class="QWidget" name="compatibility_tab">
          <attribute name="title">
           <string>Compatibility</string>
          </attribute>
          <property name="toolTip">
           <string>Game-specific rendering and CPU workarounds.</string>
          </property>
          <layout class="QVBoxLayout" name="compatibility_tab_layout">
           <property name="spacing">
            <number>16</number>
           </property>
           <item>
            <widget class="QGroupBox" name="rendering_compatibility_group">
             <property name="title">
              <string>Rendering compatibility</string>
             </property>
             <layout class="QVBoxLayout" name="renderingCompatibilityLayout">
              <item>
               <widget class="QLabel" name="label_rendering_compatibility">
                <property name="text">
                 <string>These settings may help with rendering bugs at a slight performance cost.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_sync_raw_image_buffers">
                <property name="toolTip">
                 <string>Can fix missing textures and incorrect transparency (Resident Evil 2).</string>
                </property>
                <property name="text">
                 <string>Accurate texture synchronization</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_readback">
                <property name="toolTip">
                 <string>Read back writable linear images</string>
                </property>
                <property name="text">
                 <string>Enable readback</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_readback_tiled">
                <property name="toolTip">
                 <string>Read back small writable tiled images</string>
                </property>
                <property name="text">
                 <string>Enable tiled readback</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_readback_storage">
                <property name="toolTip">
                 <string>Read back shader-written images when the game flushes the GPU cache for the CPU. Images from linear and tiled readback are read back then too.</string>
                </property>
                <property name="text">
                 <string>Enable storage readback</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_tessellation">
                <property name="toolTip">
                 <string>Draw tessellated geometry. Disabled by default; unsupported tessellation may cause crashes.</string>
                </property>
                <property name="text">
                 <string>Enable tessellation support (experimental)</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_occlusion_queries">
                <property name="toolTip">
                 <string>Count the samples of occlusion queries on the GPU, so hidden lights and objects stay hidden. Costs some performance.</string>
                </property>
                <property name="text">
                 <string>Enable occlusion queries</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_relaxed_shader_float">
                <property name="toolTip">
                 <string>Use the host GPU's native float operations in shaders. Faster, but can be inaccurate.</string>
                </property>
                <property name="text">
                 <string>Relaxed shader float math</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QGroupBox" name="compatibility_group">
             <property name="title">
              <string>Compatibility</string>
             </property>
             <layout class="QVBoxLayout" name="compatibilityLayout">
              <item>
               <widget class="QCheckBox" name="checkBox_amd_cpu">
                <property name="toolTip">
                 <string>Patch CPU instructions that differ between AMD and the host CPU.</string>
                </property>
                <property name="text">
                 <string>Intel CPU compatibility (experimental)</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_guest_tsc">
                <property name="toolTip">
                 <string>Run the CPU time stamp counter (TSC) at the PS5's 1.6 GHz instead of the host rate. Fixes games that run too fast.</string>
                </property>
                <property name="text">
                 <string>PS5 TSC rate (experimental)</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkBox_red_zone_protection">
                <property name="toolTip">
                 <string>Helps prevent crashes in some games on Windows</string>
                </property>
                <property name="text">
                 <string>Windows SysV red zone crash protection (experimental)</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QGroupBox" name="performance_tweaks_group">
             <property name="title">
              <string>Performance tweaks</string>
             </property>
             <layout class="QVBoxLayout" name="performanceTweaksLayout">
              <item>
               <widget class="QLabel" name="label_performance_tweaks">
                <property name="styleSheet">
                 <string>color: red;</string>
                </property>
                <property name="text">
                 <string>Game-specific tweaks: they may or may not improve performance. Use with caution and prefer setting them per game rather than globally.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="flushDrawsLayout">
                <item>
                 <widget class="QLabel" name="label_flush_draws">
                  <property name="text">
                   <string>Submit GPU work every N draws (0 = off):</string>
                  </property>
                  <property name="wordWrap">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QSpinBox" name="spinBox_flush_draws">
                  <property name="toolTip">
                   <string>Can lower frame time in games that send a whole frame as one command buffer, at some submit overhead.</string>
                  </property>
                  <property name="maximum">
                   <number>99999</number>
                  </property>
                 </widget>
                </item>
                <item>
                 <spacer name="flushDrawsSpacer">
                  <property name="orientation">
                   <enum>Qt::Horizontal</enum>
                  </property>
                 </spacer>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <spacer name="compatibility_tab_stretch">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
