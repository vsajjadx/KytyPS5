               <enum>QFormLayout::WrapLongRows</enum>
              </property>
              <property name="horizontalSpacing">
               <number>12</number>
              </property>
              <property name="fieldGrowthPolicy">
               <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
              </property>
              <property name="verticalSpacing">
               <number>10</number>
              </property>
              <item row="0" column="0" colspan="2">
               <widget class="QCheckBox" name="checkBox_shader_cache">
                <property name="toolTip">
                 <string>Save compiled shaders and pipelines per game and load them at startup.</string>
                </property>
                <property name="text">
                 <string>Cache shaders</string>
                </property>
               </widget>
              </item>
              <item row="1" column="0" colspan="2">
               <widget class="QCheckBox" name="checkBox_async_shaders">
                <property name="toolTip">
                 <string>Compile new shaders in the background instead of freezing the game. Whatever needs a shader that is still compiling is left out for a few frames.</string>
                </property>
                <property name="text">
                 <string>Compile shaders in the background</string>
                </property>
               </widget>
              </item>
              <item row="2" column="0" colspan="2">
               <widget class="QCheckBox" name="checkBox_async_compute">
                <property name="toolTip">
                 <string>Also compile compute shaders in the background. Turn off if a game crashes or loses effects with it on.</string>
                </property>
                <property name="text">
                 <string>Include compute shaders</string>
                </property>
               </widget>
              </item>
              <item row="3" column="0" colspan="2">
               <widget class="QCheckBox" name="checkBox_async_pipelines">
                <property name="toolTip">
                 <string>Create new pipelines (where the graphics driver compiles shaders) in the background too, waiting only a few milliseconds for each. Turn off if a screen stays white or incomplete.</string>
                </property>
                <property name="text">
                 <string>Create pipelines in the background</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
