if(NOT DEFINED EMULATOR OR NOT EXISTS "${EMULATOR}")
	message(FATAL_ERROR "EMULATOR must identify the built emulator")
endif()
function(check_cli expected diagnostic)
	execute_process(COMMAND "${EMULATOR}" --help ${ARGN}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
	if(expected STREQUAL "success")
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "valid FG options failed: ${ARGN}\n${output}\n${errors}")
		endif()
	else()
		if(result EQUAL 0 OR NOT "${output}${errors}" MATCHES "${diagnostic}")
			message(FATAL_ERROR "invalid FG options lacked a meaningful error: ${ARGN}\n${output}\n${errors}")
		endif()
	endif()
endfunction()
check_cli(success "")
foreach(backend IN ITEMS fsr multi)
	foreach(multiplier RANGE 2 6)
		check_cli(success "" --frame-generation-backend ${backend} --frame-generation-multiplier ${multiplier})
	endforeach()
endforeach()
check_cli(success "" --frame-generation --frame-generation-multiplier 5 --frame-generation-backend multi)
foreach(backend IN ITEMS invalid FSR Multi "fsr ")
	check_cli(failure "invalid frame generation backend" --frame-generation-backend "${backend}")
endforeach()
foreach(multiplier IN ITEMS 0 1 7 -1 2.5 5x 4294967296)
	check_cli(failure "invalid frame generation multiplier" --frame-generation-multiplier "${multiplier}")
endforeach()
check_cli(failure "missing value for --frame-generation-backend" --frame-generation-backend)
check_cli(failure "missing value for --frame-generation-multiplier" --frame-generation-multiplier)
message(STATUS "Frame generation CLI accepts every factor 2..6 and rejects invalid/missing options")
